# REQUIRED CONFIG
BOT_TOKEN = ""                              # Telegram Bot Token from @BotFather
OWNER_ID = ""                               # Telegram User ID of Bot Owner
OWNER_USERNAME = "issei_senpai"             # Telegram Username of Bot Owner (without @)
TELEGRAM_API = ""                           # Telegram API ID from my.telegram.org
TELEGRAM_HASH = ""                          # Telegram API Hash from my.telegram.org

# OPTIONAL CONFIG
DATABASE_URL = ""                           # MongoDB Connection URI (optional; local JSON fallback enabled)
DOWNLOAD_DIR = "/usr/src/app/downloads/"    # Temporary download directory
CMD_SUFFIX = ""                             # Custom command suffix (e.g. '1' for /leech1)
AUTHORIZED_CHATS = ""                       # Space separated Chat IDs authorized to use the bot
SUDO_USERS = ""                             # Space separated User IDs with sudo privileges
BLACKLIST_USERS = ""                        # Space separated User IDs to blacklist
STATUS_LIMIT = "4"                          # Tasks per page in /status
STATUS_UPDATE_INTERVAL = "10"               # Status refresh interval in seconds
AUTO_DELETE_MESSAGE_DURATION = "60"         # Seconds before deleting temporary messages
LEECH_SPLIT_SIZE = "2097152000"             # Leech split size in bytes (~2GB, premium users get 4GB)
BOT_PM = "False"                              # Send files to user's PM also
AS_DOCUMENT = "False"                       # Upload all media as documents by default
CAP_FONT = "code"                           # Caption font style (code, bold, italic)
LEECH_FILENAME_PREFIX = ""                  # Global filename prefix
LEECH_FILENAME_SUFFIX = ""                  # Global filename suffix
LEECH_FILENAME_CAPTION = ""                 # Global caption template
LEECH_FILENAME_REMNAME_AUTO = ""            # AutoRename template, e.g. {title} S{season}E{episode} {quality}
LEECH_FILENAME_REMNAME_REGEX = ""           # Regex remname rules, e.g. |pattern:replacement
LEECH_LOG_ID = ""                           # Channel ID to forward leeched files
TORRENT_TIMEOUT = "300"                     # Torrent stop timeout in seconds
SHORTENER_ENABLED = "True"                  # Enable or disable shortener token gate
SHORTENER = ""                              # Shortener domain (e.g. ouo.io, cutt.ly, etc.)
SHORTENER_API = ""                          # Shortener API key
TOKEN_TIMEOUT = "21600"                     # Token timeout in seconds (6 hours)
LOGIN_PASS = ""                             # Direct bypass password for token
SCREENSHOTS_MODE = "False"                  # Enable automatic screenshot generation for videos
TMDB_ACCESS_TOKEN = ""                         # TMDB API v3 Key or v4 Read Access Token for Auto Poster
AUTO_THUMBNAIL = "False"                       # Enable automatic TMDB poster as thumbnail and HD cover
COVER_IMAGE = "https://graph.org/file/60f9f8bcb97d27f76f5c0.jpg" # Default Telegraph cover image
DDL_API = ""                               # DDL API Endpoint (e.g. https://your-fqdn) for fast direct link Aria2c downloading
TIMEZONE = "Asia/Kolkata"                   # Bot timezone

# LIMITS & STORAGE MANAGEMENT (in GB / counts)
LEECH_LIMIT = ""                               # Max single leech size in GB (blank = unlimited)
TORRENT_LIMIT = ""                             # Max single torrent size in GB
DIRECT_LIMIT = ""                              # Max direct link download size in GB
YTDLP_LIMIT = ""                               # Max yt-dlp video download size in GB
EXTRACT_LIMIT = ""                             # Max archive uncompressed extraction limit in GB
ARCHIVE_LIMIT = ""                             # Max archive compression limit in GB
DAILY_LEECH_LIMIT = ""                         # Total daily bandwidth per user in GB
DAILY_TASK_LIMIT = ""                          # Total daily tasks count per user
STORAGE_THRESHOLD = "1"                        # Minimum free disk space in GB to preserve on server

